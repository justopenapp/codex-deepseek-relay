HOST=127.0.0.1
PORT=8787

# Provider: deepseek or xfyun.
PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

XFYUN_API_KEY=your-xfyun-api-key
XFYUN_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
XFYUN_MODEL=astron-code-latest

# Optional diagnostics.
LOG_LEVEL=info
MAX_BODY_BYTES=20971520
UPSTREAM_STREAM_INCLUDE_USAGE=false
REASONING_OUTPUT=tagged
DEBUG_UPSTREAM=false

# Backward-compatible DeepSeek names are still accepted.
DEEPSEEK_STREAM_INCLUDE_USAGE=false
DEEPSEEK_REASONING_OUTPUT=tagged
DEBUG_DEEPSEEK=false
